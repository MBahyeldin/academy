{
  "kind": "collectionType",
  "collectionName": "instructor_profiles",
  "info": {
    "singularName": "instructor-profile",
    "pluralName": "instructor-profiles",
    "displayName": "Instructor Profile"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "nameAr": {
      "type": "string",
      "required": true
    },
    "nameEn": {
      "type": "string"
    },
    "bio": {
      "type": "text"
    },
    "credentials": {
      "type": "string"
    },
    "profilePicture": {
      "type": "string"
    },
    "yearsExperience": {
      "type": "integer"
    },
    "courses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course.course",
      "mappedBy": "instructor"
    }
  }
}
