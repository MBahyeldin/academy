{
  "kind": "collectionType",
  "collectionName": "lessons",
  "info": {
    "singularName": "lesson",
    "pluralName": "lessons",
    "displayName": "Lesson",
    "description": "Lesson inside a module"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "videoUrl": {
      "type": "string"
    },
    "durationMinutes": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "type": {
      "type": "enumeration",
      "enum": ["video", "reading", "quiz"],
      "default": "video",
      "required": true
    },
    "module": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::module.module",
      "inversedBy": "lessons"
    }
  }
}
